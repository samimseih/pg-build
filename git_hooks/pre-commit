#!/usr/bin/env python3
"""pre-commit hook: reject non-ASCII bytes in staged additions.

PostgreSQL sources are ASCII-only. A stray Unicode dash, smart-quote, or
non-breaking space (easy to paste in, or have an agent introduce) gets a
patch bounced on -hackers. This checks only *added* lines in the staged
diff, so pre-existing non-ASCII content elsewhere does not block unrelated
commits. Bypass with `git commit --no-verify` when you genuinely need to.
"""
import subprocess
import sys


def main() -> int:
    # -U0: only changed lines, no context. Added lines start with '+'
    # (but skip the '+++ ' file header lines).
    diff = subprocess.run(
        ["git", "diff", "--cached", "-U0", "--no-color"],
        capture_output=True, text=True,
    ).stdout

    offenders = []
    current_file = None
    new_lineno = 0
    for line in diff.splitlines():
        if line.startswith("+++ b/"):
            current_file = line[6:]
            continue
        if line.startswith("@@"):
            # @@ -a,b +c,d @@  -> next added line is at c
            try:
                plus = line.split("+", 1)[1]
                new_lineno = int(plus.split(",")[0].split(" ")[0])
            except (IndexError, ValueError):
                new_lineno = 0
            continue
        if line.startswith("+") and not line.startswith("+++"):
            content = line[1:]
            for col, ch in enumerate(content, start=1):
                if ord(ch) > 0x7F:
                    offenders.append((current_file, new_lineno, col, ch))
                    break
            new_lineno += 1

    if offenders:
        print("pre-commit: non-ASCII byte(s) in staged additions "
              "(PostgreSQL is ASCII-only):", file=sys.stderr)
        for f, ln, col, ch in offenders:
            print(f"  {f}:{ln} col {col}: U+{ord(ch):04X} {ch!r}", file=sys.stderr)
        print("Fix, or bypass with `git commit --no-verify`.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
